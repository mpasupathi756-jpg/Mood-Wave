# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL / Supabase ───────────────
# Option 1: Supabase / Cloud connection URL (Transaction/Session Pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option 2: Individual variables (for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=moodwave_v2
DB_SSL=false

# ── JWT ──────────────────────────────────
JWT_SECRET=MoodWave_SuperSecure_Postgres_Key_2026!ChangeThisSecret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Jamendo API ──────────────────────────
JAMENDO_CLIENT_ID=24b564e3

# ── Frontend ─────────────────────────────
FRONTEND_URL=http://localhost:5173
